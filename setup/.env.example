# 프로젝트 루트에 .env 로 복사하세요 (copy setup\.env.example .env). 이 파일은 git 에 커밋하지 마세요.
# 비워 두면 해당 기능은 자동으로 폴백됩니다 (LLM → 추출식 답변, 임베딩 → 로컬 hash).
# 주의: 이미 OS 환경변수로 설정된 키는 .env 값으로 덮어쓰지 않습니다 (config show --effective 로 확인).

# ======================================================================
# A. 사내 LLM 게이트웨이 — 접속 URL + PAT(Personal Access Token) 방식
# ======================================================================
# A-1) OpenAI-compatible 게이트웨이 (/v1/chat/completions, /v1/embeddings)
#   config.json: "llm_provider": "openai", "openai_base_url": "https://gateway.corp/v1", "llm_model": "<게이트웨이 모델 id>"
#   PAT 는 아래 둘 중 하나에 (이름만 다르고 동작은 같음). 헤더 이름은 config openai_api_key_header
#   (authorization → "Bearer <PAT>", api-key / x-api-key → 값 그대로).
OPENAI_API_KEY=
# LLM_API_KEY=                              # OPENAI_API_KEY 대신 써도 됨 (PAT 가 OpenAI 와 무관할 때 이름이 헷갈리지 않도록)
# OPENAI_EMBED_API_KEY=                     # 임베딩 엔드포인트 키가 다를 때 (없으면 위 키 공용)

# A-2) Anthropic-compatible 게이트웨이 (/v1/messages)
#   config.json: "llm_provider": "anthropic", "anthropic_base_url": "https://gateway.corp", "llm_fallbacks": false
#   PAT 가 Bearer 방식이면 ANTHROPIC_AUTH_TOKEN, x-api-key 방식이면 ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_BASE_URL=                       # anthropic SDK 가 설치된 경우 SDK 도 이 변수를 읽음 (config anthropic_base_url 과 같은 값 권장)

# ======================================================================
# B. 기타 프로바이더
# ======================================================================
# Voyage AI (의미 임베딩, 선택)
VOYAGE_API_KEY=
# rerank 전용 엔드포인트 (Cohere / Jina / vLLM /v1/rerank / Voyage) — URL/모델은 config.json rerank_url, rerank_api_model
RERANK_API_KEY=
# 외부 MCP 소스 인증 (mcp_sources.json 의 env 항목이 참조)
# MANGO_MCP_TOKEN=
# headless 에이전트(opencode 등)가 필요로 하는 변수는 agents.json 의 "env" 에 넣거나 여기 두면 subprocess 에 그대로 전달됩니다.
# OPENCODE_API_KEY=

# ======================================================================
# C. config.json 값을 환경변수로 덮어쓰기 (선택)
# ======================================================================
# 규칙: 모든 설정 키는 LLMWIKI_<키 대문자>, 토글은 LLMWIKI_TOGGLE_<이름 대문자>, 역할별 모델은 LLMWIKI_<역할>_MODEL|PROVIDER|EFFORT
#   전체 목록: python -m llmwiki config show --effective
# LLMWIKI_LLM_PROVIDER=openai              # auto | anthropic | openai | ollama | headless:<agent> | mock | none  (auto 는 openai/headless 를 고르지 않음)
# LLMWIKI_LLM_MODEL=gpt-4o-mini
# LLMWIKI_OPENAI_BASE_URL=https://gateway.corp/v1
# LLMWIKI_OPENAI_API_KEY_HEADER=authorization   # authorization | api-key | x-api-key
# LLMWIKI_ANTHROPIC_BASE_URL=https://gateway.corp
# LLMWIKI_LLM_TIMEOUT=600                  # LLM 호출 1회 타임아웃(초)
# LLMWIKI_EMBED_PROVIDER=auto              # auto | hash | voyage | openai | ollama | st
# LLMWIKI_EMBED_MODEL=                     # voyage-3.5 | bge-m3 | nomic-embed-text | paraphrase-multilingual-MiniLM-L12-v2
# LLMWIKI_EMBED_DIM=4096                   # hash 임베딩 차원 (변경 시 build --full)
# LLMWIKI_EMBED_STORE_DTYPE=float32        # float32 | float16
# LLMWIKI_RERANK_URL=http://localhost:8000/v1/rerank
# LLMWIKI_RERANK_API_MODEL=BAAI/bge-reranker-v2-m3
# LLMWIKI_ANSWER_MODEL=claude-opus-5
# LLMWIKI_ANSWER_PROVIDER=headless:opencode
# LLMWIKI_TOGGLE_FALLBACK_LOOP=true
# LLMWIKI_TIMEZONE=Asia/Seoul
# LLMWIKI_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
# LLMWIKI_OLLAMA_URL=http://localhost:11434
# LLMWIKI_OLLAMA_MODEL=llama3.1
# LLMWIKI_CORPUS_DIRS=corpus;D:\docs\other   # 세미콜론(;)으로 여러 폴더
# LLMWIKI_CONFIG=C:\path\to\other-config.json
# 파일 위치 변경: LLMWIKI_<NAME>_PATH  (NAME = CONFIG ENV TUNING PRESETS QUERY_RULES MCP_SOURCES AGENTS PINS RULES SCHEMAS_DIR PROMPTS_DIR EVAL LOGS_DIR SECURITY)
# LLMWIKI_LOGS_DIR_PATH=D:\llmwiki\logs

# 콘솔 한글 출력 깨짐 방지 (Windows)
PYTHONIOENCODING=utf-8
