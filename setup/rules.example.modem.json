  "_comment_id_patterns": "id_patterns = 문서 ID 표기. 조직이 JIRA-/MR- 을 쓰면 여기와 schemas/*.json 의 id_pattern 을 함께 바꾸세요.",
  "id_patterns": [
    {"type": "issue", "regex": "\\bISSUE[-_ ]?(\\d{3,7})\\b", "canonical": "ISSUE-{1}"},
    {"type": "cl", "regex": "\\bCL[-_ ]?(\\d{3,8})\\b", "canonical": "CL-{1}"},
    {"type": "tc", "regex": "\\bTC-([A-Z0-9_-]{2,})\\b", "canonical": "TC-{1}"},
    {"type": "sw_design", "regex": "\\bSWD-([A-Z0-9_-]{2,})\\b", "canonical": "SWD-{1}"},
    {"type": "hw_design", "regex": "\\bHWD-([A-Z0-9_-]{2,})\\b", "canonical": "HWD-{1}"},
    {"type": "coding_rule", "regex": "\\bRULE-([A-Z0-9_-]{2,})\\b", "canonical": "RULE-{1}"},
    {"type": "weekly_report", "regex": "\\bWR-(\\d{4}-W\\d{2})\\b", "canonical": "WR-{1}"},
    {"type": "spec", "regex": "\\b(3GPP\\s?TS\\s?\\d{2}\\.\\d{3})\\b", "canonical": "{1}"}
  ],

  "_comment_relation_patterns": "relation_patterns = front matter/본문의 '**키**: 값' 을 관계로. value 가 잡은 문자열을 무엇으로 읽을지(entity|date|money|percent|text|id), in_chunk/in_decision 이 어디서 적용할지를 정합니다. **코드를 고치지 않고** 여기에 줄을 추가하면 됩니다.",
  "relation_patterns": [
    {"name": "owner", "regex": "\\*\\*담당\\*\\*\\s*[:：]\\s*([^\\n]+)", "value": "entity",
     "in_decision": {"rel": "owner", "weight": 1.0, "confidence": 0.9, "desc": "담당: "},
     "in_chunk": {"rel": "responsible", "weight": 0.8, "confidence": 0.7, "desc": "담당: "}},
    {"name": "deadline", "regex": "\\*\\*(?:마감|적용|일정)\\*\\*\\s*[:：]\\s*([^\\n]+)", "value": "date",
     "in_decision": {"rel": "deadline", "weight": 1.0, "confidence": 0.85, "desc": "마감/적용: "}},

    {"name": "affected_module", "regex": "\\*\\*(?:영향\\s*모듈|모듈|module)\\*\\*\\s*[:：]\\s*([^\\n]+)", "value": "text", "node_type": "module", "split": ",",
     "in_chunk": {"rel": "affects_module", "weight": 0.8, "confidence": 0.8, "desc": "영향 모듈: "}},
    {"name": "register", "regex": "\\*\\*(?:레지스터|register)\\*\\*\\s*[:：]\\s*([^\\n]+)", "value": "text", "node_type": "register", "split": ",",
     "in_chunk": {"rel": "touches_register", "weight": 0.8, "confidence": 0.8, "desc": "레지스터: "}},
    {"name": "hw_block", "regex": "\\*\\*(?:HW\\s*블록|hw_block)\\*\\*\\s*[:：]\\s*([^\\n]+)", "value": "text", "node_type": "hw_block", "split": ",",
     "in_chunk": {"rel": "in_block", "weight": 0.7, "confidence": 0.8, "desc": "HW 블록: "}},
    {"name": "chip_rev", "regex": "\\*\\*(?:칩|리비전|hw_rev|chip)\\*\\*\\s*[:：]\\s*([^\\n]+)", "value": "entity",
     "in_chunk": {"rel": "on_chip", "weight": 0.7, "confidence": 0.85, "desc": "칩/리비전: "}},
    {"name": "root_cause_of", "regex": "\\*\\*(?:근본\\s*원인|root\\s*cause)\\*\\*\\s*[:：]\\s*([^\\n]+)", "value": "id",
     "in_chunk": {"rel": "root_cause_of", "weight": 1.0, "confidence": 0.9, "desc": "근본 원인: "}},
    {"name": "spec_ref", "regex": "\\*\\*(?:규격|spec|표준)\\*\\*\\s*[:：]\\s*([^\\n]+)", "value": "id",
     "in_chunk": {"rel": "conforms_to", "weight": 0.8, "confidence": 0.85, "desc": "규격: "}},
    {"name": "measured", "regex": "\\*\\*(?:측정|실측)\\*\\*\\s*[:：]\\s*([^\\n]+)", "value": "percent",
     "in_chunk": {"rel": "measured_value", "weight": 0.5, "confidence": 0.7, "desc": "측정: "}},
    {"name": "source", "regex": "출처\\s*[:：]\\s*([^\\n]+)", "value": "entity",
     "in_chunk": {"rel": "source", "weight": 0.7, "confidence": 0.8, "desc": "출처: "}}
  ],

