# 사용자별 설정/비밀 (setup/ 의 example 파일만 커밋)
.env
config.json
# 로컬 계정의 비밀번호 해시와 API 키가 들어 있다 — 절대 커밋하지 않는다.
# (2026-09-24: 여기에 빠져 있어서 실수로 올라갈 수 있었다. setup/security.example.json 을 쓴다.)
security.json
security.json.bak
# 설정 파일의 백업/손상 사본 (config bundle·복원이 만든다)
*.bak-*
*.corrupt-*
# 재생성 가능한 산출물
data/*.sqlite3*
data/snapshots/
data/server.log
data/build.lock
data/mcp_cache/
data/q.json
logs/
wiki/*.md
# 사용자 코퍼스 (README 만 유지; 샘플은 setup/sample_corpus_modem/ 에 커밋)
corpus/*
!corpus/README.md
# python
__pycache__/
*.pyc
.venv/
