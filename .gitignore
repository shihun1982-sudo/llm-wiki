# 사용자별 설정/비밀 (setup/ 의 example 파일만 커밋)
.env
config.json
# 재생성 가능한 산출물
data/*.sqlite3*
data/snapshots/
data/server.log
data/build.lock
data/mcp_cache/
data/q.json
logs/
wiki/*.md
