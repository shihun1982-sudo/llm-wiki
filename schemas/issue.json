{
  "title": "이슈 문서 (현상 · 원인 · 분석 · 수정)",
  "extends": "common",
  "id_pattern": "^ISSUE-\\d{3,7}$",
  "fields": {
    "status": {
      "type": "enum",
      "values": [
        "open",
        "analyzing",
        "fixed",
        "verified",
        "closed",
        "wontfix"
      ],
      "required": true
    },
    "severity": {
      "type": "enum",
      "values": [
        "critical",
        "major",
        "minor",
        "trivial"
      ],
      "required": false
    },
    "related": {
      "type": "map",
      "required": false,
      "desc": "cls 에 수정 CL 나열"
    }
  },
  "sections": {
    "recommended": [
      "현상",
      "원인",
      "분석",
      "수정",
      "검증"
    ],
    "required": [
      "현상"
    ]
  }
}