{
  "title": "Change List (수정 반영)",
  "extends": "common",
  "id_pattern": "^CL-\\d{3,8}$",
  "fields": {
    "related": {
      "type": "map",
      "required": true,
      "desc": "issues 필수 (CL 은 반드시 이슈 번호를 명시)"
    },
    "status": {
      "type": "enum",
      "values": [
        "review",
        "merged",
        "reverted"
      ],
      "required": false
    },
    "files": {
      "type": "list",
      "required": false,
      "desc": "변경 파일 목록"
    }
  },
  "required_related": [
    "issues"
  ],
  "sections": {
    "recommended": [
      "변경 내용",
      "영향 범위",
      "테스트"
    ],
    "required": []
  }
}