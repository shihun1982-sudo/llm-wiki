# 프로젝트 루트에 .env 로 복사하세요 (copy setup\.env.example .env). 이 파일은 git 에 커밋하지 마세요.
# 비워 두면 해당 기능은 자동으로 폴백됩니다 (LLM → 추출식 답변, 임베딩 → 로컬 hash).

# --- Anthropic Claude (LLM 그래프 추출 / 리랭크 / 답변 / 자가진화 리뷰) ---
ANTHROPIC_API_KEY=

# --- Voyage AI (의미 임베딩, 선택) ---
VOYAGE_API_KEY=

# --- config.json 값을 환경변수로 덮어쓰기 (선택) ---
# LLMWIKI_LLM_MODEL=claude-opus-5          # 예: claude-sonnet-5, claude-haiku-4-5
# LLMWIKI_LLM_PROVIDER=auto                # auto | anthropic | ollama | mock | none
# LLMWIKI_EMBED_PROVIDER=auto              # auto | hash | voyage | ollama | st
# LLMWIKI_EMBED_MODEL=                     # voyage-3.5 | nomic-embed-text | paraphrase-multilingual-MiniLM-L12-v2
# LLMWIKI_OLLAMA_URL=http://localhost:11434
# LLMWIKI_OLLAMA_MODEL=llama3.1
# LLMWIKI_CORPUS_DIRS=corpus;D:\docs\other   # 세미콜론(;)으로 여러 폴더
# LLMWIKI_CONFIG=C:\path\to\other-config.json

# 콘솔 한글 출력 깨짐 방지 (Windows)
PYTHONIOENCODING=utf-8
