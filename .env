# 프로젝트 루트 .env — 이 파일은 git 에 커밋하지 마세요. 전체 항목과 설명은 setup/.env.example 참조.
# 비워 두면 해당 기능은 자동으로 폴백됩니다 (LLM → 추출식 답변, 임베딩 → 로컬 hash).

# --- A. 사내 게이트웨이(PAT) ---
# OpenAI-compatible: config.json llm_provider=openai, openai_base_url=https://gateway.corp/v1  (헤더: openai_api_key_header)
OPENAI_API_KEY=
# LLM_API_KEY=                 # OPENAI_API_KEY 와 동일 역할 (이름만 다름)
# Anthropic-compatible: config.json llm_provider=anthropic, anthropic_base_url=https://gateway.corp
ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=        # Bearer 방식 PAT

# --- B. 기타 ---
VOYAGE_API_KEY=
RERANK_API_KEY=

# --- C. config.json 덮어쓰기 (선택) — 예: LLMWIKI_LLM_PROVIDER=openai, LLMWIKI_LLM_TIMEOUT=120 ---
# LLMWIKI_LLM_PROVIDER=auto                # auto | anthropic | openai | ollama | headless:<agent> | mock | none
# LLMWIKI_OLLAMA_URL=http://localhost:11434
# LLMWIKI_OLLAMA_MODEL=llama3.1

# 콘솔 한글 출력 깨짐 방지 (Windows)
PYTHONIOENCODING=utf-8
